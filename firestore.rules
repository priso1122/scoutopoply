rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function room(roomId) { return get(/databases/$(database)/documents/gameRooms/$(roomId)); }
    function isMember(roomId) { return signedIn() && request.auth.uid in room(roomId).data.members; }
    function isHost(roomId) { return isMember(roomId) && room(roomId).data.hostUid == request.auth.uid; }

    match /gameRooms/{roomId} {
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow read: if isMember(roomId);
      // Production game-state writes must go through Cloud Functions. This stops
      // clients from forging dice, TP, base ownership, Honor, and final scores.
      allow update, delete: if false;

      match /players/{playerId} {
        allow read: if isMember(roomId);
        allow create, update: if signedIn() && playerId == request.auth.uid;
        allow delete: if signedIn() && playerId == request.auth.uid;
      }
      match /events/{eventId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId);
        allow update, delete: if false;
      }
      match /trades/{tradeId} {
        allow read: if isMember(roomId);
        allow write: if false;
      }
    }
    match /users/{userId} {
      allow read, write: if signedIn() && userId == request.auth.uid;
    }
  }
}
